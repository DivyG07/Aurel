DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
AUTH_TRUST_HOST=true
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only these emails can open /admin (comma-separated)
ADMIN_EMAILS="i25divyg@iimidr.ac.in"

# Cloudflare Turnstile. These are Cloudflare's public TEST keys (always pass).
# Replace with your own from https://dash.cloudflare.com/?to=/:account/turnstile before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Google Sheets live mirror — see docs/GOOGLE_SHEETS.md
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_SECRET="any-long-random-string"
# Razorpay (test mode) — Dashboard → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
# Optional: webhook secret for <site>/api/razorpay/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=""
# Set to false to let members bid without the refundable deposit
REQUIRE_BIDDER_DEPOSIT=true

# Optional Zapier chatbot embed ID
NEXT_PUBLIC_ZAPIER_CHATBOT_ID=""
